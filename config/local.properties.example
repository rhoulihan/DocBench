# Local configuration template
# Copy this file to local.properties and update with your credentials
# DO NOT commit local.properties

# MongoDB configuration
# Use replicaSet parameter for production-like durability testing (j:true support)
mongodb.uri=mongodb://username:password@localhost:27017/database?replicaSet=rs0
mongodb.database=testdb

# Oracle JDBC configuration (for AWR reports and edition detection)
# Requires Oracle Database 21c+ with SODA enabled
oracle.url=jdbc:oracle:thin:@localhost:1521/FREEPDB1
oracle.username=docbench
oracle.password=password
oracle.database=docbench

# Oracle MongoDB API configuration (for $sql aggregation operator)
# This enables the $lookup vs $sql benchmark using Oracle's MongoDB-compatible API
# Port 27018 avoids conflict with native MongoDB on port 27017
# Connection string format from ORDS: requires authMechanism=PLAIN, authSource=$external
oracle.mongodb.uri=mongodb://docbench:docbench123@localhost:27018/docbench?authMechanism=PLAIN&authSource=$external&ssl=false&retryWrites=false&loadBalanced=true
oracle.mongodb.database=docbench

# Oracle Setup:
# 1. Connect as SYSDBA: sqlplus sys as sysdba
# 2. Grant permissions:
#    GRANT SODA_APP TO docbench;
#    GRANT CREATE TABLE TO docbench;
#    GRANT CREATE PROCEDURE TO docbench;
# 3. Enable ORDS MongoDB API (required for $sql aggregation):
#    See: https://docs.oracle.com/en/database/oracle/oracle-rest-data-services/
# 4. Configure MongoDB API listener in ORDS
